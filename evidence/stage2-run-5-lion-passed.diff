@@ -37,6 +37,13 @@ class Product:
             line = batch.deallocate_one()
             self.events.append(events.Deallocated(line.orderid, line.sku, line.qty))
 
+    def deallocate(self, orderid: str, sku: str):
+        batch = next(b for b in self.batches for line in b._allocations if line.orderid == orderid and line.sku == sku)
+        line = next(line for line in batch._allocations if line.orderid == orderid and line.sku == sku)
+        batch.deallocate(line)
+        self.version_number += 1
+        self.events.append(events.AllocationCancelled(orderid=orderid, sku=sku, qty=line.qty))
+
 
 @dataclass(unsafe_hash=True)
 class OrderLine:
@@ -78,6 +85,10 @@ class Batch:
     def deallocate_one(self) -> OrderLine:
         return self._allocations.pop()
 
+    def deallocate(self, line: OrderLine):
+        if line in self._allocations:
+            self._allocations.remove(line)
+
     @property
     def allocated_quantity(self) -> int:
         return sum(line.qty for line in self._allocations)
